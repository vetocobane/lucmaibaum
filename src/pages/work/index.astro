---
import Base from "../../layouts/Base.astro";
import projects from "../../projects.json";

const categories = ["All", "Commercial", "Music", "Fashion", "Narrative"];
---

<Base title="Work — Luc Maibaum" path="/work">
  <section class="shell page-head">
    <p class="eyebrow">{projects.length} projects</p>
    <h1 class="display">Work</h1>
  </section>

  <section class="shell">
    <div class="filters">
      {categories.map((c) => (
        <button type="button" data-filter={c} class={c === "All" ? "is-active" : undefined}>{c}</button>
      ))}
    </div>

    <div class="grid">
      {projects.map((p) => (
        <a class="tile" href={`/work/${p.slug}`} data-category={p.category}>
          <div class="frame">
            <img src={p.stillFiles[0]} alt={p.title} loading="lazy" />
          </div>
          <div class="meta">
            <h3>{p.title}</h3>
            <span>{p.category}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .filters button {
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.25s, border-color 0.25s, background 0.25s;
  }
  .filters button:hover { color: var(--fg); border-color: rgba(244, 243, 241, 0.4); }
  .filters button.is-active { background: var(--fg); border-color: var(--fg); color: var(--bg); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(1.5rem, 3vw, 3rem) clamp(1.5rem, 2.5vw, 2.5rem);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.5s;
  }
  .tile:hover .frame img { transform: scale(1.04); filter: saturate(1.05); }
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }
  .meta h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .meta span {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tile[hidden] { display: none; }
</style>

<script>
  const buttons = document.querySelectorAll(".filters button");
  const tiles = document.querySelectorAll(".tile");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
      tiles.forEach((t) => { t.hidden = filter !== "All" && t.dataset.category !== filter; });
      history.replaceState(null, "", filter === "All" ? location.pathname : `?c=${filter.toLowerCase()}`);
    });
  });

  const preset = new URLSearchParams(location.search).get("c");
  if (preset) {
    const match = [...buttons].find((b) => b.dataset.filter.toLowerCase() === preset);
    if (match) match.click();
  }
</script>

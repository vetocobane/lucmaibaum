---
const { stills, title } = Astro.props;
const pad = (n) => String(n).padStart(2, "0");
---

<section class="slideshow" data-interval="6200" aria-roledescription="carousel" aria-label={`Stills from ${title}`}>
  <div class="stage">
    {stills.map((src, i) => (
      <figure class={i === 0 ? "slide is-active" : "slide"} aria-hidden={i === 0 ? undefined : "true"}>
        <img src={src} alt={`${title} still ${i + 1}`} loading={i < 2 ? "eager" : "lazy"} draggable="false" />
      </figure>
    ))}

    <button class="edge prev" type="button" aria-label="Previous still">
      <span class="arrow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </span>
    </button>
    <button class="edge next" type="button" aria-label="Next still">
      <span class="arrow">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </span>
    </button>
  </div>

  <div class="bar">
    <div class="dots" role="tablist">
      {stills.map((_, i) => (
        <button
          class={i === 0 ? "dot is-active" : "dot"}
          type="button"
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Still ${i + 1}`}
        ></button>
      ))}
    </div>
    <p class="counter eyebrow"><span class="now">{pad(1)}</span> / {pad(stills.length)}</p>
  </div>
</section>

<style>
  .slideshow { margin-top: clamp(2.5rem, 5vw, 4rem); }

  .stage {
    position: relative;
    height: min(56.25vw, 86svh);
    background: #000;
    overflow: hidden;
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.6s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  .slide.is-active { opacity: 1; }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* Drift only runs on the frame currently on screen. */
  .slide.is-active img { animation: drift 9s ease-out forwards; }

  @keyframes drift {
    from { transform: scale(1.005); }
    to { transform: scale(1.065); }
  }

  .edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 42%;
    border: 0;
    padding: 0 clamp(1rem, 3vw, 3rem);
    background: transparent;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .prev { left: 0; justify-content: flex-start; }
  .next { right: 0; justify-content: flex-end; }

  .arrow {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(6px);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.35s, transform 0.35s, background 0.3s;
  }
  .edge:hover .arrow,
  .edge:focus-visible .arrow { opacity: 1; transform: scale(1); }
  .edge:hover .arrow { background: rgba(0, 0, 0, 0.45); }
  .arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    padding: 1.25rem var(--gutter) 0;
  }

  .dots { display: flex; gap: 0.6rem; }
  .dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 1px solid rgba(244, 243, 241, 0.45);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background 0.3s, border-color 0.3s, transform 0.3s;
  }
  .dot:hover { border-color: var(--fg); transform: scale(1.25); }
  .dot.is-active { background: var(--fg); border-color: var(--fg); }

  .counter { margin: 0; font-variant-numeric: tabular-nums; }
  .counter .now { color: var(--fg); }

  @media (prefers-reduced-motion: reduce) {
    .slide { transition-duration: 0.2s; }
    .slide.is-active img { animation: none; }
  }

  @media (max-width: 640px) {
    .stage { height: min(75vw, 70svh); }
    .arrow { width: 44px; height: 44px; }
  }
</style>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll(".slideshow").forEach((root) => {
    const slides = [...root.querySelectorAll(".slide")];
    const dots = [...root.querySelectorAll(".dot")];
    const now = root.querySelector(".now");
    const interval = Number(root.dataset.interval) || 6000;
    if (slides.length < 2) return;

    let index = 0;
    let timer = null;
    let visible = true;
    let held = false;

    const show = (next) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === index;
        s.classList.toggle("is-active", on);
        s.toggleAttribute("aria-hidden", !on);
      });
      dots.forEach((d, i) => {
        d.classList.toggle("is-active", i === index);
        d.setAttribute("aria-selected", i === index ? "true" : "false");
      });
      now.textContent = String(index + 1).padStart(2, "0");
    };

    const stop = () => { clearInterval(timer); timer = null; };
    const play = () => {
      stop();
      if (reduced || !visible || held) return;
      timer = setInterval(() => show(index + 1), interval);
    };
    const step = (delta) => { show(index + delta); play(); };

    root.querySelector(".prev").addEventListener("click", () => step(-1));
    root.querySelector(".next").addEventListener("click", () => step(1));
    dots.forEach((d) => d.addEventListener("click", () => { show(Number(d.dataset.index)); play(); }));

    // Let a viewer linger on a frame without it moving on.
    root.addEventListener("pointerenter", () => { held = true; stop(); });
    root.addEventListener("pointerleave", () => { held = false; play(); });
    root.addEventListener("focusin", () => { held = true; stop(); });
    root.addEventListener("focusout", () => { held = false; play(); });

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
      if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
    });

    new IntersectionObserver(
      ([entry]) => { visible = entry.isIntersecting; play(); },
      { threshold: 0.25 }
    ).observe(root);

    play();
  });
</script>

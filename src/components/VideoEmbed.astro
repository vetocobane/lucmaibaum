---
const { provider, id, poster, label } = Astro.props;
const src =
  provider === "vimeo"
    ? `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0&dnt=1&autoplay=1`
    : `https://www.youtube-nocookie.com/embed/${id}?rel=0&modestbranding=1&playsinline=1&autoplay=1`;
---

<div class="embed" data-src={src}>
  <img src={poster} alt={label} loading="eager" />
  <button type="button" aria-label={`Play ${label}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  </button>
</div>

<style>
  .embed {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
    cursor: pointer;
  }
  .embed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.4s;
  }
  .embed:hover img { transform: scale(1.02); opacity: 0.85; }
  .embed button {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 84px;
    height: 84px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s, border-color 0.3s;
  }
  .embed:hover button { background: rgba(0, 0, 0, 0.5); border-color: #fff; }
  .embed button svg { width: 30px; height: 30px; fill: currentColor; margin-left: 3px; }
  .embed iframe { width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll(".embed").forEach((el) => {
    el.addEventListener("click", () => {
      const frame = document.createElement("iframe");
      frame.src = el.dataset.src;
      frame.allow = "autoplay; fullscreen; picture-in-picture";
      frame.allowFullscreen = true;
      el.replaceChildren(frame);
    }, { once: true });
  });
</script>
